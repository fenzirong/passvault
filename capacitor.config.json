{
  "appId": "com.passvault.app",
  "appName": "密码保险库",
  "webDir": "web",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 300,
      "backgroundColor": "#0d0f14",
      "showSpinner": false
    }
  }
}
